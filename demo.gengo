// Modbus TCP client demo.
//
// Connects to the simulated temperature controller server and exercises
// all range-based callbacks:
//   - Reads temperature (registers 10–11) and humidity (12–13) ranges
//   - Writes a new setpoint (single-register range, triggers clamping callback)
//   - Writes alarm thresholds (2-register range, triggers log callback)
//   - Toggles heater and fan coils (single-coil ranges)
//   - Reads the dynamic alarm coil
//   - Tests partial-range error (reading just register 10 should fail)
//   - Reads/writes float registers via codec
//
// Usage:
//   gengo --cap net --modules ./modbus demo.gengo

std := import("std")
net := import("cap:net")
mb  := import("./modbus/client")
cdc := import("./modbus/codec")

host    := "127.0.0.1"
port    := 5020
unit_id := 1

func print_error(msg string, err string) {
    std.io.println("  error: " + msg + ": " + err)
}

func run() {
    addr := host + ":" + std.conv.to_string(port)
    std.io.println("connecting to " + addr + " unit " + std.conv.to_string(unit_id))

    conn := net.dial("tcp", addr)
    if std.core.is_error(conn) {
        std.io.eprintln("connect " + addr + ": " + string(conn))
        return
    }
    defer conn.close()
    conn.set_deadline(5000)

    client := mb.Client { unit_id: unit_id, tx_id: 0 }

    // ── read temperature range (registers 10–11) ────────────────────────────

    std.io.println("")
    std.io.println("read temperature (registers 10–11, range=2)")
    regs, err := mb.read_holding_registers(conn, client, 10, 2)
    if err != null {
        print_error("read_holding_registers", string(err))
    } else {
        // decode 16-bit halves back to full value
        temp := (regs[0] & 255) * 256 + (regs[1] & 255)
        std.io.println("  temperature = " + std.conv.to_string(int(temp / 100)) + "." + std.conv.to_string(temp rem 100) + " C")
        std.io.println("  raw regs:   [" + std.conv.to_string(regs[0]) + ", " + std.conv.to_string(regs[1]) + "]")
    }

    // ── read humidity range (registers 12–13) ───────────────────────────────

    std.io.println("")
    std.io.println("read humidity (registers 12–13, range=2)")
    regs, err = mb.read_holding_registers(conn, client, 12, 2)
    if err != null {
        print_error("read_holding_registers", string(err))
    } else {
        hum := (regs[0] & 255) * 256 + (regs[1] & 255)
        std.io.println("  humidity    = " + std.conv.to_string(int(hum / 100)) + "." + std.conv.to_string(hum rem 100) + " %")
    }

    // ── read setpoint (single register, count=1 range) ──────────────────────

    std.io.println("")
    std.io.println("read setpoint (register 0)")
    regs, err = mb.read_holding_registers(conn, client, 0, 1)
    if err != null {
        print_error("read_holding_registers", string(err))
    } else {
        std.io.println("  setpoint = " + std.conv.to_string(regs[0]) + " (" + std.conv.to_string(int(regs[0] / 100)) + "." + std.conv.to_string(regs[0] rem 100) + " C)")
    }

    // ── write new setpoint (triggers clamping callback) ──────────────────────

    std.io.println("")
    std.io.println("write setpoint = 28.00 C (2800)")
    err = mb.write_single_register(conn, client, 0, 2800)
    if err != null {
        print_error("write_single_register", string(err))
    } else {
        std.io.println("  ok")
    }

    // read back
    std.io.println("")
    std.io.println("read back setpoint")
    regs, err = mb.read_holding_registers(conn, client, 0, 1)
    if err != null {
        print_error("read_holding_registers", string(err))
    } else {
        std.io.println("  setpoint = " + std.conv.to_string(regs[0]) + " (" + std.conv.to_string(int(regs[0] / 100)) + "." + std.conv.to_string(regs[0] rem 100) + " C)")
    }

    // ── write alarm thresholds (range=2, triggers log callback) ─────────────

    std.io.println("")
    std.io.println("write alarm thresholds (registers 1–2) = [4000, 500]")
    err = mb.write_multiple_registers(conn, client, 1, [4000, 500])
    if err != null {
        print_error("write_multiple_registers", string(err))
    } else {
        std.io.println("  ok")
    }

    // ── toggle heater ───────────────────────────────────────────────────────

    std.io.println("")
    std.io.println("turn on heater (coil 0)")
    err = mb.write_single_coil(conn, client, 0, true)
    if err != null {
        print_error("write_single_coil", string(err))
    } else {
        std.io.println("  ok")
    }

    // ── toggle fan ──────────────────────────────────────────────────────────

    std.io.println("")
    std.io.println("turn on fan (coil 1)")
    err = mb.write_single_coil(conn, client, 1, true)
    if err != null {
        print_error("write_single_coil", string(err))
    } else {
        std.io.println("  ok")
    }

    // ── read alarm coil (dynamic) ───────────────────────────────────────────

    std.io.println("")
    std.io.println("read alarm coil (dynamic: temp > setpoint + 5C)")
    coils := []
    coils, err = mb.read_coils(conn, client, 2, 1)
    if err != null {
        print_error("read_coils", string(err))
    } else {
        alarm := "no"
        if coils[0] { alarm = "YES" }
        std.io.println("  alarm = " + alarm)
    }

    // ── read all coils ──────────────────────────────────────────────────────

    std.io.println("")
    std.io.println("read all coils 0..3")
    coils, err = mb.read_coils(conn, client, 0, 4)
    if err != null {
        print_error("read_coils", string(err))
    } else {
        labels := ["heater", "fan", "alarm", "spare"]
        i := 0
        for c in coils {
            state := "OFF"
            if c { state = "ON" }
            std.io.println("  " + labels[i] + " [" + std.conv.to_string(i) + "] = " + state)
            i = i + 1
        }
    }

    // ── test partial-range error (read just register 10, part of range 10–11)

    std.io.println("")
    std.io.println("test partial-range error (read register 10 alone)")
    regs, err = mb.read_holding_registers(conn, client, 10, 1)
    if err != null {
        std.io.println("  correctly rejected: partial read of float32 range")
    } else {
        std.io.println("  ERROR: should have been rejected, got " + std.conv.to_string(regs[0]))
    }

    // ── write and read back floats via codec (CDAB byte order) ──────────────

    codec := cdc.Codec { byte_order: cdc.CDAB }

    std.io.println("")
    std.io.println("write float32 3.14159 and float32 2.71828 to registers 20..23 (CDAB)")
    w := codec.writer()
    w.f32(3.14159)
    w.f32(2.71828)
    err = mb.write_multiple_registers(conn, client, 20, w.regs())
    if err != null {
        print_error("write_multiple_registers", string(err))
    } else {
        std.io.println("  ok")
    }

    std.io.println("")
    std.io.println("read back registers 20..23 and decode via reader cursor")
    regs, err = mb.read_holding_registers(conn, client, 20, 4)
    if err != null {
        print_error("read_holding_registers", string(err))
    } else {
        r := codec.reader(regs)
        std.io.println("  pi    = " + std.conv.to_string(r.f32()))
        std.io.println("  euler = " + std.conv.to_string(r.f32()))
    }

    std.io.println("")
    std.io.println("done")
}

run()
